{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "node_modules/.tmp/tsc-node",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node",
      "electron-vite/node"
    ]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*.ts",
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "tests/unit/**/*.ts"
  ]
}
